generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String              @unique @db.VarChar(255)
  emailVerified Boolean             @default(false) @map("email_verified")
  image         String?             @db.Text
  name          String              @db.VarChar(100)
  accounts      Account[]
  sessions      Session[]
  mentorProfile MentorProfile?
  sentRequests  MentorshipRequest[] @relation("Requester")
  notifications Notification[]
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique @db.Text
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model MentorProfile {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @unique @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bio             String              @db.Text
  experienceYears Int                 @map("experience_years")
  skills          MentorSkill[]
  requests        MentorshipRequest[]
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mentor_profiles")
}

model Skill {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @unique @db.VarChar(80)
  mentorSkills  MentorSkill[]
  requestSkills MentorshipRequestSkill[]
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("skills")
}

model MentorSkill {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorProfileId String        @map("mentor_profile_id") @db.Uuid
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  skillId         String        @map("skill_id") @db.Uuid
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([mentorProfileId, skillId])
  @@index([skillId])
  @@map("mentor_skills")
}

model MentorshipRequest {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId     String                   @map("requester_id") @db.Uuid
  requester       User                     @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mentorProfileId String                   @map("mentor_profile_id") @db.Uuid
  mentorProfile   MentorProfile            @relation(fields: [mentorProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  skills          MentorshipRequestSkill[]
  message         String                   @db.Text
  status          String                   @default("pending") @db.VarChar(20)
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([mentorProfileId])
  @@index([requesterId])
  @@index([status])
  @@map("mentorship_requests")
}

model MentorshipRequestSkill {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String           @map("request_id") @db.Uuid
  request   MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  skillId   String           @map("skill_id") @db.Uuid
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([requestId, skillId])
  @@index([skillId])
  @@map("mentorship_request_skills")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  type      String    @map("type") @db.VarChar(20)
  title     String    @db.VarChar(120)
  body      String    @db.Text
  link      String    @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, readAt])
  @@map("notifications")
}
